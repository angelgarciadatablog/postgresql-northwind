# Copia este archivo a .env y rellena tus propios valores.
# .env está en .gitignore — nunca se sube a GitHub.

# --- Neon (nube) -------------------------------------------------------------
# Panel de Neon -> tu proyecto -> Connect -> Connection string
NEON_DATABASE_URL=postgresql://usuario:contrasena@ep-xxxx.us-east-2.aws.neon.tech/northwind?sslmode=require

# --- PostgreSQL local --------------------------------------------------------
LOCAL_DATABASE_URL=postgresql://localhost:5432/northwind

# --- Docker ------------------------------------------------------------------
# Debe coincidir con docker/docker-compose.yml
DOCKER_DATABASE_URL=postgresql://northwind:northwind@localhost:5433/northwind
